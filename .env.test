# Loaded by Vite whenever mode === "test", which is what vitest runs in.
#
# src/lib/env.ts validates import.meta.env at module load and throws if
# VITE_API_BASE_URL or VITE_GOOGLE_CLIENT_ID is missing, so any test that
# imports a module which (transitively) imports env.ts needs these set.
# On a developer's machine the real .env supplied them; CI has no .env, so
# without this file the suite fails there and passes locally.
#
# Placeholders on purpose. Nothing here is a secret and no test should
# reach either value over the network.
VITE_API_BASE_URL=http://localhost:3000
VITE_GOOGLE_CLIENT_ID=test-google-client-id.apps.googleusercontent.com
