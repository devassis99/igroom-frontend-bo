# Base URL of igroom-backend, no trailing slash.
VITE_API_BASE_URL=http://localhost:3000

# Same Google Cloud Console OAuth 2.0 Web Client ID as the backend's
# GOOGLE_CLIENT_ID (src/config/env.ts in igroom-backend). The backend
# verifies its token audience against this exact client id, so the two
# MUST match.
VITE_GOOGLE_CLIENT_ID=
